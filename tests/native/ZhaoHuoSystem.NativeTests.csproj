<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\LegendOfMortal</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ZhaoHuoSystem/LuaGate.cs" Link="LuaGate.cs" />
    <Compile Include="../../src/ZhaoHuoSystem/LuaOptions.cs" Link="LuaOptions.cs" />
    <Compile Include="../../src/ZhaoHuoSystem/ValueSemantics.cs" Link="ValueSemantics.cs" />
    <Compile Include="../../src/ZhaoHuoSystem/NativeEnumSemantics.cs" Link="NativeEnumSemantics.cs" />
    <Compile Include="../../src/ZhaoHuoSystem/FieldIdentityIndex.cs" Link="FieldIdentityIndex.cs" />
    <Compile Include="../../src/ZhaoHuoSystem/MapSemantics.cs" Link="MapSemantics.cs" />
    <Compile Include="../../src/ZhaoHuoSystem/Contracts.cs" Link="Contracts.cs" />
    <Compile Include="../../src/ZhaoHuoSystem/FlagDictionary.cs" Link="FlagDictionary.cs" />
    <Compile Include="../../src/ZhaoHuoSystem/SaveNoteStore.cs" Link="SaveNoteStore.cs" />
    <Reference Include="Fungus">
      <HintPath>$(GameDir)\Mortal_Data\Managed\Fungus.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
